{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wrcd/v2/argument-map.schema.json",
  "title": "Argument Map v2",
  "type": "object", "additionalProperties": false,
  "required": ["global_main_line", "paragraph_order"],
  "properties": {
    "global_main_line": {"type": "string", "minLength": 1},
    "paragraph_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^D[0-9]+$"}}
  }
}
