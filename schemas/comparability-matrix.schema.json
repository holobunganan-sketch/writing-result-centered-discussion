{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wrcd/v2/comparability-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "claim_id", "dimensions", "overall", "interpretive_use"],
        "properties": {
          "result_id": {"type": "string", "pattern": "^R[0-9]+$"},
          "claim_id": {"type": "string", "pattern": "^REF-[0-9]{3,}-C[0-9]+$"},
          "dimensions": {
            "type": "object",
            "minProperties": 1,
            "required": ["population", "design", "intervention_or_exposure", "outcome", "follow_up", "setting"],
            "additionalProperties": false,
            "properties": {
              "population": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}},
              "design": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}},
              "intervention_or_exposure": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}},
              "outcome": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}},
              "follow_up": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}},
              "setting": {"type": "object", "additionalProperties": false, "required": ["study", "external", "rating", "impact"], "properties": {"study": {"type": "string"}, "external": {"type": "string"}, "rating": {"enum": ["high", "medium", "low", "not-applicable"]}, "impact": {"type": "string"}}}
            }
          },
          "overall": {"enum": ["high", "medium", "low", "not-comparable"]},
          "interpretive_use": {"enum": ["benchmark", "support", "contrast", "difference-explanation", "boundary", "not-usable"]}
        }
      }
    }
  }
}
