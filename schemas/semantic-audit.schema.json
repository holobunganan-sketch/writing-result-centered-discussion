{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wrcd/v2/semantic-audit.schema.json",
  "type": "object", "additionalProperties": false, "required": ["draft_hash", "paragraphs"],
  "properties": {
    "draft_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "paragraphs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "one_sentence_summary", "single_central_claim", "result_focus", "sentence_functions", "claim_support", "citation_deletion_tests", "topic_drift", "strength_within_evidence", "returns_to_study", "issues", "revision_instruction", "status"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^D[0-9]+$"},
        "one_sentence_summary": {"type": "string", "minLength": 1},
        "single_central_claim": {"type": "boolean"},
        "result_focus": {"type": "boolean"},
        "sentence_functions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sentence", "function"], "properties": {"sentence": {"type": "string"}, "function": {"enum": ["study-result", "question", "comparison", "contrast", "difference-explanation", "mechanism", "boundary", "implication", "return-to-study", "other"]}}},
        "claim_support": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "supported_sentence", "supports", "reason"], "properties": {"claim_id": {"type": "string", "pattern": "^REF-[0-9]{3,}-C[0-9]+$"}, "supported_sentence": {"type": "string"}, "supports": {"type": "boolean"}, "reason": {"type": "string"}}},
        "citation_deletion_tests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "loss_if_removed", "advances_argument"], "properties": {"claim_id": {"type": "string"}, "loss_if_removed": {"type": "string"}, "advances_argument": {"type": "boolean"}}},
        "topic_drift": {"type": "boolean"},
        "strength_within_evidence": {"type": "boolean"},
        "returns_to_study": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "revision_instruction": {"type": "string"},
        "status": {"enum": ["pass", "revise"]}
      }
    }}
  }
}
