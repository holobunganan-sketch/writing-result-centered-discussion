{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wrcd/v2/semantic-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft_hash", "reviewer", "paragraphs", "overall_status"],
  "properties": {
    "draft_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "central_summary", "one_central_claim", "linked_result_focus", "sentence_functions", "citation_assessments", "topic_drift", "return_to_study", "overclaiming", "revision_instructions", "status"],
        "properties": {
          "contract_id": {"type": "string", "pattern": "^D[0-9]+$"},
          "central_summary": {"type": "string", "minLength": 1},
          "one_central_claim": {"type": "boolean"},
          "linked_result_focus": {"type": "boolean"},
          "sentence_functions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sentence", "function"],
              "properties": {
                "sentence": {"type": "integer", "minimum": 1},
                "function": {"type": "string", "minLength": 1}
              }
            }
          },
          "citation_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "supported_statement", "advances_argument", "deletion_consequence"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "supported_statement": {"type": "string", "minLength": 1},
                "advances_argument": {"type": "boolean"},
                "deletion_consequence": {"type": "string", "minLength": 1}
              }
            }
          },
          "topic_drift": {"type": "boolean"},
          "return_to_study": {"type": "boolean"},
          "overclaiming": {"type": "array", "items": {"type": "string"}},
          "revision_instructions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["pass", "revise", "pending"]}
        }
      }
    },
    "overall_status": {"enum": ["pass", "revise", "pending"]}
  }
}
